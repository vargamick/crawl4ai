# Crawl4AI Docker Network Configuration
# Copy this to .env to use with docker-compose-network.yml

# Image and build configuration
IMAGE=unclecode/crawl4ai
TAG=latest
INSTALL_TYPE=default
ENABLE_GPU=false

# Port configuration
FRONTEND_PORT=3000

# API Keys (optional - create .llm.env for actual keys)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_TOKEN=
LLM_PROVIDER=

# Development settings
NODE_ENV=production
DEBUG=false
