# Crawl4AI LLM API Keys Configuration
# SECURITY WARNING: This file contains API keys - never commit actual keys to version control
# Copy this file and replace placeholder values with your actual API keys

# Groq API Key (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# DeepSeek API Key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Together AI API Key (https://api.together.xyz/)
TOGETHER_API_KEY=your_together_api_key_here

# Mistral API Key (https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# Google Gemini API Token (https://makersuite.google.com/app/apikey)
GEMINI_API_TOKEN=your_gemini_api_token_here

# Optional: Set default LLM provider (e.g., "openai", "anthropic", "groq")
LLM_PROVIDER=
